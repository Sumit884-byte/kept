{
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/sync-public.js",
  "outputDirectory": "src/public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/((?!r/).*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/favicon.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ],
  "functions": {
    "api/server.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfkit/js/standard-fonts/**"
    },
    "api/example.js": {
      "includeFiles": "node_modules/pdfkit/js/standard-fonts/**"
    }
  },
  "rewrites": [
    { "source": "/github/auth/callback", "destination": "/api/github/callback" },
    { "source": "/sample", "destination": "/api/example?format=redirect" },
    { "source": "/example.pdf", "destination": "/api/example?format=pdf" },
    { "source": "/r/keptsample", "destination": "/api/example?format=page" },
    { "source": "/r/keptsample.pdf", "destination": "/api/example?format=pdf" },
    { "source": "/((?:.*/)?\\.(?!well-known(?:/|$)).*)", "destination": "/404" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
