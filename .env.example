PORT=3000
PUBLIC_URL=http://localhost:3000
NODE_ENV=development

# Postgres URL. Locally this is the Docker TimescaleDB. Production uses a Tiger Cloud URL.
TIGER_DATABASE_URL=postgres://postgres:postgres@localhost:5433/current
TIGER_POOL_MAX=5

# Long random string. Changing it signs everyone out and locks saved GitHub access.
APP_SECRET=replace-with-a-long-random-string

# GitHub OAuth App. Callback: {PUBLIC_URL}/github/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Clerk. Email and password, with an email code for a new account.
# In the Clerk dashboard, add http://localhost:3000 as an allowed origin.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SECRET_KEY=

# Used to sign incoming GitHub hook calls. Changing it means hooks must be created again.
WEBHOOK_SECRET=

# Optional. Address of an OpenAI-compatible model. On Render this is the private
# Gemma service (host:port). Leave unset locally and the role falls back to the write-ups.
# A key is only needed when that host asks for one. The request still sets storage off.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gemma-3-4b-it

# How many proxy hops to trust for the client IP used by rate limits.
# Defaults to 1 in production (Render/Vercel) and off locally, so X-Forwarded-For cannot be spoofed.
TRUST_PROXY=

# How often to ask GitHub whether a project changed, in milliseconds.
POLL_INTERVAL_MS=600000
