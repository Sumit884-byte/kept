{
  "name": "kept",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "layout:screenshots": "node scripts/layout-screenshots.mjs",
    "pdf:preview": "node scripts/pdf-preview.mjs",
    "html:preview": "node scripts/html-preview.mjs",
    "hero:preview": "node scripts/hero-preview.mjs",
    "nav:audit": "node scripts/nav-audit.mjs",
    "brave:demo": "node scripts/brave-walkthrough.mjs",
    "demo:record": "node scripts/kept-walkthrough-record.mjs",
    "demo:record:brave": "CDP=http://127.0.0.1:9222 node scripts/kept-walkthrough-record.mjs",
    "walkthrough:audit": "WALKTHROUGH_FAST=1 node scripts/walkthrough-audit.mjs"
  },
  "devDependencies": {
    "playwright": "^1.51.0"
  },
  "dependencies": {
    "@clerk/express": "^2.1.75",
    "@react-pdf/renderer": "^4.3.0",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "react": "^19.0.0"
  }
}
